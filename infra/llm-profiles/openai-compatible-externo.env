# API externa compatível com OpenAI. Preencha URL, chave e modelo.
# ATENÇÃO (LGPD): com provedor externo, LLM_SENDS_PERSONAL_DATA começa em false. Só mude para true
# depois de decisão registrada em DECISOES.md (contrato, retenção, transferência internacional).
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.exemplo.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_JSON_MODE=json_schema
LLM_EXTRA_BODY={}
LLM_STRIP_THINKING=true
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_CONTEXT_TOKENS=32000
LLM_TIMEOUT_S=120
LLM_MAX_CONCURRENCY=2
LLM_MAX_RETRIES=3
LLM_SENDS_PERSONAL_DATA=false
