# Ollama (API compatível com OpenAI em /v1). No host: http://host.containers.internal:11434/v1
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://host.containers.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:4b
LLM_JSON_MODE=json_object
LLM_EXTRA_BODY={}
LLM_STRIP_THINKING=true
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_CONTEXT_TOKENS=8192
LLM_TIMEOUT_S=300
LLM_MAX_CONCURRENCY=1
LLM_MAX_RETRIES=3
LLM_SENDS_PERSONAL_DATA=true
