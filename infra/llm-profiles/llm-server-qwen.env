# Qwen3-4B-Instruct-2507 (llama.cpp). Sem raciocínio; aceita response_format json_schema (gramática).
# BASE_URL: llm-server compartilhado (http://llm:8081/v1) se ele estiver com o Qwen,
#           ou o contêiner de teste infra/llm-teste (http://mana-llm-teste:8081/v1).
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://mana-llm-teste:8081/v1
LLM_API_KEY=
LLM_MODEL=qwen3-4b-instruct-2507
LLM_JSON_MODE=json_schema
LLM_EXTRA_BODY={}
LLM_STRIP_THINKING=true
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_CONTEXT_TOKENS=4096
LLM_TIMEOUT_S=300
LLM_MAX_CONCURRENCY=1
LLM_MAX_RETRIES=3
LLM_SENDS_PERSONAL_DATA=true
