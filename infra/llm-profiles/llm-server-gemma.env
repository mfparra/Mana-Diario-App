# llm-server compartilhado (CacaPalavras2/llm-server) — Gemma 4 E4B Q4_K_M com raciocínio, ctx 4096, 1 req/vez.
# Gemma + response_format json_object devolve vazio no llama.cpp → JSON_MODE=none (o servidor extrai e valida).
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://llm:8081/v1
LLM_API_KEY=
LLM_MODEL=gemma-4-e4b-it
LLM_JSON_MODE=none
LLM_EXTRA_BODY={}
LLM_STRIP_THINKING=true
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_CONTEXT_TOKENS=4096
LLM_TIMEOUT_S=300
LLM_MAX_CONCURRENCY=1
LLM_MAX_RETRIES=3
LLM_SENDS_PERSONAL_DATA=true
