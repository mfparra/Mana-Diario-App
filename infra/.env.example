# Copie para infra/.env (ignorado pelo git) e preencha. Nunca commite segredos.

# --- Banco ---
# O compose monta DATABASE_URL a partir destas três (use senha só com [A-Za-z0-9_-], sem precisar de URL-encoding).
POSTGRES_DB=manadiario
POSTGRES_USER=manadiario
POSTGRES_PASSWORD=troque-me

# --- Rede ---
# compose.dev.yaml: 0.0.0.0 para testar no celular pela rede local
API_BIND=127.0.0.1
# perfil prod (Caddy/HTTPS) — DECISOES S7
API_DOMAIN=api.exemplo.com.br

# --- Servidor ---
APP_ENV=development
APP_TIMEZONE=America/Sao_Paulo
ADMIN_TOKEN=troque-me
JWT_SECRET=troque-me
# chave para criptografia de anotações/perfil
# Chaves AES-256 (32 bytes base64url) no formato id:chave[,id:chave_antiga]; a primeira cifra.
# Gerar: python3 -c "import secrets; print('1:' + secrets.token_urlsafe(32))"
FIELD_ENCRYPTION_KEY=troque-me

# --- Login Google (OAuth client "Web" = aud do ID token) ---
GOOGLE_WEB_CLIENT_ID=

# --- Google Play (assinatura) ---
GOOGLE_PLAY_PACKAGE_NAME=com.marcosparra.manadiario
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=/run/secrets/play-service-account.json

# --- AdMob (IDs reais ficam em android/local.properties, não aqui) ---

# --- LLM (ver docs/LLM_SERVER.md §4) ---
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://llm:8081/v1
LLM_API_KEY=
LLM_MODEL=gemma-4-e4b-it
LLM_JSON_MODE=none
LLM_EXTRA_BODY={}
LLM_STRIP_THINKING=true
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_CONTEXT_TOKENS=4096
LLM_TIMEOUT_S=300
LLM_MAX_CONCURRENCY=1
LLM_MAX_RETRIES=3
LLM_SENDS_PERSONAL_DATA=true
LLM_HEALTH_TIMEOUT_S=3
