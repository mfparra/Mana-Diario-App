# Proxy reverso com HTTPS automático (Let's Encrypt). Domínio em API_DOMAIN (DECISOES S7).
{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
	log {
		output stdout
		format json
	}
}
